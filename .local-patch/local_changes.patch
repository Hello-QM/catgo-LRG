+  write_tag(279, 4, 1, rgb.length)               // StripByteCounts
+  write_tag(282, 5, 1, x_res_offset)             // XResolution → RATIONAL
+  write_tag(283, 5, 1, y_res_offset)             // YResolution → RATIONAL
